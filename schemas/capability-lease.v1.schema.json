{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ethereal-nexus.local/schemas/capability-lease.v1.schema.json",
  "title": "Ethereal Nexus Capability Lease v1",
  "type": "object",
  "required": ["version","lease_id","node_id","capability_id","actor","authority","scope","issued_at","expires_at","status"],
  "properties": {
    "version": { "const": 1 },
    "lease_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "node_id": { "type": "string", "minLength": 1 },
    "capability_id": { "type": "string", "minLength": 1 },
    "repository_id": { "type": ["string","null"] },
    "actor": {
      "type": "object",
      "required": ["type","id"],
      "properties": {
        "type": { "enum": ["human","agent","service","council"] },
        "id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "authority": { "type": "string", "minLength": 1 },
    "purpose": { "type": ["string","null"] },
    "scope": {
      "type": "object",
      "required": ["targets","actions"],
      "properties": {
        "targets": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "actions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "network": { "type": "array", "items": { "type": "string" } },
        "filesystem": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["PROPOSED","ACTIVE","EXPIRED","REVOKED"] },
    "human_approval": {
      "type": "object",
      "properties": {
        "required": { "type": "boolean" },
        "approved_by": { "type": ["string","null"] },
        "approved_at": { "type": ["string","null"], "format": "date-time" }
      },
      "additionalProperties": true
    },
    "evidence_requirements": { "type": "array", "items": { "type": "string" } },
    "stop_conditions": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": ["string","null"] }
  },
  "additionalProperties": true
}