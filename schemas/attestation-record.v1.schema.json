{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ethereal-nexus.local/schemas/attestation-record.v1.schema.json",
  "title": "Ethereal Nexus Attestation Record v1",
  "type": "object",
  "required": ["version","attestation_id","node_id","created_at","subject","digest","claims","issuer"],
  "properties": {
    "version": { "const": 1 },
    "attestation_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "node_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "subject": { "type": "string", "minLength": 1 },
    "digest": {
      "type": "object",
      "required": ["algorithm","value"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "value": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "issuer": {
      "type": "object",
      "required": ["type","id"],
      "properties": {
        "type": { "enum": ["human","node","service","council","ci"] },
        "id": { "type": "string", "minLength": 1 },
        "public_key_fingerprint": { "type": ["string","null"] }
      },
      "additionalProperties": true
    },
    "signature": {
      "type": ["object","null"],
      "properties": {
        "algorithm": { "type": "string" },
        "value": { "type": "string" }
      },
      "additionalProperties": true
    },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "run_id": { "type": ["string","null"] },
    "notes": { "type": ["string","null"] }
  },
  "additionalProperties": true
}